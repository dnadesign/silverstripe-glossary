{
  "name": "dnadesign/silverstripe-glossary",
  "description": "A dictionary like module allowing definitions to be set for in-content words.",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "silverstripe",
    "glossary",
    "definition"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^5.0",
    "symbiote/silverstripe-gridfieldextensions": "^4.0"
  },
  "require-dev": {
    "phpecs/phpecs": "^2.3"
  },
  "extra": {
    "expose": [
      "client"
    ]
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    },
    "sort-packages": true
  }
}
