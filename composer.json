{
  "name": "dnadesign/silverstripe-glossary",
  "description": "A dictionary like module allowing definitions to be set for in-content words.",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "silverstripe",
    "glossary",
    "definition"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "php": "^8.3",
    "silverstripe/admin": "^3.0",
    "silverstripe/framework": "^6.0",
    "silverstripe/htmleditor-tinymce": "^1.0",
    "symbiote/silverstripe-gridfieldextensions": "^5.0"
  },
  "require-dev": {
    "cambis/silverstan": "^2.1",
    "cambis/silverstripe-rector": "^2.1",
    "phpecs/phpecs": "^2.3",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "rector/rector": "^2.3"
  },
  "extra": {
    "expose": [
      "client"
    ]
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "phpstan/extension-installer": true,
      "silverstripe/vendor-plugin": true
    },
    "sort-packages": true
  }
}
